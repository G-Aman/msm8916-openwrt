--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-generic-uf02.dts
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Tukzer WM3311 (SP971-V4) 4G Modem Stick";
+	compatible = "tukzer,wm3311-sp971v4", "uf02,250605v0s", "yiming,uz801-v3", "qcom,msm8916";
+};
+
+&button_restart {
+	gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+};
+
+/*
+ * Tukzer SP971-V4 Physical LEDs:
+ * - Red LED:   TLMM GPIO 10 (Active High, default power indicator)
+ * - Green LED: TLMM GPIO 9  (Active High, WAN indicator)
+ * - Blue LED:  TLMM GPIO 6  (Active High, WLAN indicator)
+ */
+&led_r {
+	function = LED_FUNCTION_POWER;
+	color = <LED_COLOR_ID_RED>;
+	gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+	default-state = "on";
+	linux,default-trigger = "default-on";
+};
+
+&led_g {
+	function = LED_FUNCTION_WAN;
+	color = <LED_COLOR_ID_GREEN>;
+	gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+	default-state = "off";
+	linux,default-trigger = "heartbeat";
+};
+
+&led_b {
+	function = LED_FUNCTION_WLAN;
+	color = <LED_COLOR_ID_BLUE>;
+	gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+	default-state = "off";
+	linux,default-trigger = "phy0radio";
+};
+
+&button_default {
+	pins = "gpio23";
+	bias-pull-down;
+};
+
+&gpio_leds_default {
+	pins = "gpio6", "gpio9", "gpio10", "gpio36", "gpio71", "gpio72", "gpio73";
+};
+
+&pm8916_rpm_regulators {
+	pm8916_l9: l9 {
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+};
+
+&wcnss {
+	status = "okay";
+	vddpx-supply = <&pm8916_l7>;
+};
+
+&wcnss_iris {
+	compatible = "qcom,wcn3620";
+	status = "okay";
+
+	/* Internal WCN3620 2.4GHz RF Power Amplifier supplies */
+	vddxo-supply = <&pm8916_l7>;
+	vddrfa-supply = <&pm8916_s3>;
+	vddpa-supply = <&pm8916_l9>;
+	vdddig-supply = <&pm8916_l5>;
+};
